{
  "name": "pillow",
  "version": "0.1.0",
  "description": "A local-first, project-scoped AI development environment.",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "check": "node scripts/check-workspace.mjs && pnpm typecheck && pnpm test && node scripts/run-cargo.mjs test --workspace && node scripts/run-cargo.mjs clippy --workspace -- -D warnings",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "desktop:dev": "pnpm --filter @pillow/desktop tauri dev",
    "desktop:test:e2e": "pnpm --filter @pillow/desktop test:e2e",
    "desktop:smoke": "node scripts/smoke-desktop.mjs --mode release",
    "desktop:smoke:dev": "node scripts/smoke-desktop.mjs --mode dev",
    "desktop:smoke:self-test": "node scripts/smoke-desktop.mjs --self-test",
    "desktop:cargo:self-test": "node scripts/run-cargo.mjs --self-test",
    "acceptance:grok-acp": "node scripts/native-acceptance-grok-acp.mjs",
    "acceptance:grok-acp:dry-run": "node scripts/native-acceptance-grok-acp.mjs --dry-run",
    "acceptance:grok-acp:self-test": "node scripts/native-acceptance-grok-acp.mjs --self-test",
    "acceptance:grok-acp:live": "node scripts/native-acceptance-grok-acp.mjs --live"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.1",
    "playwright-core": "1.55.0"
  }
}
