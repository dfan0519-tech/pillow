{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pillow",
  "version": "0.1.0",
  "identifier": "com.pillow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pillow",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
